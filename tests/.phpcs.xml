<?xml version="1.0"?>
<ruleset>
	<description>Sniff code to check different PHP compatibility an PSR-12 Code Style</description>

	<!-- What to scan -->
	<file>../</file>

	<exclude-pattern type="relative">^tests/*</exclude-pattern>
	<exclude-pattern type="relative">^vendor/*</exclude-pattern>
	<exclude-pattern type="relative">^node_modules/*</exclude-pattern>
	<exclude-pattern>*.blade.php</exclude-pattern>

	<!-- How to scan -->
	<!-- Usage instructions: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Usage -->
	<!-- Annotated ruleset: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="basepath" value="./"/><!-- Strip the file paths down to the relevant bit -->
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="exclude" value="PSR12.ControlStructures.ControlStructureSpacing"/>
	<arg value="n"/>

	<!-- Rules: Check PHP version compatibility (whole package including bundled libraries) -->
	<!-- https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="5.6-"/>

	<rule ref="PHPCompatibility"/>

	<!-- Code style is checked only for the package own code, bundled libraries are maintained in their repositories -->
	<rule ref="PSR12">
		<exclude-pattern>lib/Cleantalk/*</exclude-pattern>
		<exclude-pattern>src/lib/*</exclude-pattern>
		<exclude-pattern>src/config/*</exclude-pattern>
		<!-- Class constant visibility requires PHP 7.1+ -->
		<exclude name="PSR12.Properties.ConstantVisibility"/>
	</rule>

	<!-- apbct_spam_test() is a public API, its name is kept for backward compatibility -->
	<rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
		<exclude-pattern>src/CleantalkValidate.php</exclude-pattern>
	</rule>
</ruleset>
